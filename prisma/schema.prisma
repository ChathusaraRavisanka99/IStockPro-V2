generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  manager
  staff
}

enum PhoneStatus {
  InStock
  Reserved
  Sold
  Returned
  Repair
  WrittenOff
}

enum SaleStatus {
  Draft
  Completed
  Voided
}

enum InvoiceStatus {
  Draft
  Unpaid
  PartiallyPaid
  Paid
  Voided
}

enum PaymentMethod {
  Cash
  Card
  BankTransfer
  Cheque
  UPI
  Other
}

enum ReturnCondition {
  Resalable
  Repairable
  Damaged
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String?   @unique
  username     String    @unique
  passwordHash String
  role         UserRole  @default(staff)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs    AuditLog[]
}

model PhoneModel {
  id                String         @id @default(cuid())
  brand             String
  modelName         String
  lowStockThreshold Int            @default(3)
  warrantyMonths    Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  variants          PhoneVariant[]
  quotationItems    QuotationItem[]

  @@unique([brand, modelName])
}

model PhoneVariant {
  id          String      @id @default(cuid())
  phoneModel  PhoneModel  @relation(fields: [phoneModelId], references: [id], onDelete: Cascade)
  phoneModelId String
  variantName String
  color       String?
  storage     String?
  ram         String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  phones      Phone[]
  quotationItems QuotationItem[]

  @@unique([phoneModelId, variantName])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots      Lot[]
}

model Lot {
  id             String   @id @default(cuid())
  lotNumber      String   @unique
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  supplierId     String
  purchaseDate   DateTime
  shippingCost   Decimal  @default(0)
  taxCost        Decimal  @default(0)
  customsCost    Decimal  @default(0)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  phones         Phone[]
}

model Phone {
  id            String      @id @default(cuid())
  imei          String      @unique
  serialNumber  String?
  phoneVariant  PhoneVariant @relation(fields: [phoneVariantId], references: [id])
  phoneVariantId String
  lot           Lot         @relation(fields: [lotId], references: [id])
  lotId         String
  purchasePrice Decimal
  wholesalePrice Decimal?
  retailPrice   Decimal?
  repairCost    Decimal      @default(0)
  status        PhoneStatus  @default(InStock)
  warrantyStart DateTime?
  warrantyEnd   DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  saleItems     SaleItem[]
  returnItems   ReturnItem[]
}

model Accessory {
  id                String   @id @default(cuid())
  name              String
  category          String
  sku               String   @unique
  quantity          Int      @default(0)
  soldQuantity      Int      @default(0)
  lowStockThreshold Int      @default(10)
  purchasePrice     Decimal
  salePrice         Decimal
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  saleItems         SaleItem[]
  returnItems       ReturnItem[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]
  quotations Quotation[]
}

model Sale {
  id          String      @id @default(cuid())
  saleNumber  String      @unique
  customer    Customer?   @relation(fields: [customerId], references: [id])
  customerId  String?
  saleDate    DateTime    @default(now())
  subtotal    Decimal
  taxAmount   Decimal     @default(0)
  discount    Decimal     @default(0)
  totalAmount Decimal
  status      SaleStatus  @default(Completed)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       SaleItem[]
  invoice     Invoice?
  returns     Return[]
}

model SaleItem {
  id            String    @id @default(cuid())
  sale           Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId         String
  phone          Phone?    @relation(fields: [phoneId], references: [id])
  phoneId        String?
  accessory      Accessory? @relation(fields: [accessoryId], references: [id])
  accessoryId    String?
  quantity       Int       @default(1)
  unitPrice      Decimal
  lineTotal      Decimal
  createdAt      DateTime  @default(now())
  returnItems    ReturnItem[]

  @@index([phoneId])
  @@index([accessoryId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId        String        @unique
  status        InvoiceStatus @default(Unpaid)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  totalAmount   Decimal
  paidAmount    Decimal       @default(0)
  pdfUrl        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments      Payment[]
}

model Payment {
  id            String        @id @default(cuid())
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String
  method        PaymentMethod
  amount        Decimal
  reference     String?
  proofImageUrl String?
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
}

model Return {
  id          String      @id @default(cuid())
  returnNumber String     @unique
  sale        Sale        @relation(fields: [saleId], references: [id])
  saleId      String
  returnDate  DateTime    @default(now())
  reason      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       ReturnItem[]
  returnInvoice ReturnInvoice?
}

model ReturnItem {
  id            String          @id @default(cuid())
  return        Return          @relation(fields: [returnId], references: [id], onDelete: Cascade)
  returnId      String
  saleItem      SaleItem        @relation(fields: [saleItemId], references: [id])
  saleItemId    String
  phone         Phone?          @relation(fields: [phoneId], references: [id])
  phoneId       String?
  accessory     Accessory?      @relation(fields: [accessoryId], references: [id])
  accessoryId   String?
  quantity      Int             @default(1)
  condition     ReturnCondition
  lineAmount    Decimal
  notes         String?
}

model ReturnInvoice {
  id               String   @id @default(cuid())
  return           Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  returnId         String   @unique
  creditNoteNumber String   @unique
  totalCredit      Decimal
  pdfUrl           String?
  createdAt        DateTime @default(now())
}

model Quotation {
  id             String          @id @default(cuid())
  quoteNumber    String          @unique
  customer       Customer?       @relation(fields: [customerId], references: [id])
  customerId     String?
  quoteDate      DateTime        @default(now())
  validUntil     DateTime?
  taxPercent     Decimal         @default(0)
  handlingFee    Decimal         @default(0)
  subtotal       Decimal         @default(0)
  totalAmount    Decimal         @default(0)
  status         String          @default("Draft")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items          QuotationItem[]
}

model QuotationItem {
  id             String       @id @default(cuid())
  quotation      Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId    String
  description    String?
  phoneModel     PhoneModel?  @relation(fields: [phoneModelId], references: [id])
  phoneModelId   String?
  phoneVariant   PhoneVariant? @relation(fields: [phoneVariantId], references: [id])
  phoneVariantId String?
  quantity       Int          @default(1)
  unitPrice      Decimal
  lineTotal      Decimal
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String?
  amount      Decimal
  expenseDate DateTime
  receiptUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TaxPayment {
  id          String              @id @default(cuid())
  period      String
  amount      Decimal
  paidDate    DateTime
  note        String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  receipts    TaxPaymentReceipt[]
}

model TaxPaymentReceipt {
  id            String     @id @default(cuid())
  taxPayment     TaxPayment @relation(fields: [taxPaymentId], references: [id], onDelete: Cascade)
  taxPaymentId   String
  fileUrl        String
  createdAt      DateTime   @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  details     Json?
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
}
