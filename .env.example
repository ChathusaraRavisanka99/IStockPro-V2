# Postgres connection string Prisma reads (see prisma/schema.prisma datasource).
# For serverless deployments against Supabase, use the pooled connection string
# (port 6543, ?pgbouncer=true) instead of the direct one to avoid exhausting connections.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/istockpro_v2?schema=public"

# Random secret used to sign NextAuth session JWTs. Generate a real one before
# deploying, e.g.: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-strong-secret"

# Must match the app's actual deployed URL (no trailing slash).
NEXTAUTH_URL="http://localhost:3000"

# Supabase Storage, accessed via its S3-compatible protocol (see src/lib/storage.ts).
# Get these from Supabase Dashboard > Project Settings > Storage > S3 Connection.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="proofs"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_S3_ENDPOINT=""
SUPABASE_S3_REGION=""
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
